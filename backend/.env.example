# ai-chat-app（ZD Code）后端环境配置模板
# 用法：cp .env.example .env 后按说明填真实值。.env 已在 .gitignore 中；
# 本模板只放占位符与说明，真实口令/内网地址/人员名单一律不得写入本文件。

# ── 基本 ──

# Claude Code 工作目录（绝对路径）
WORKSPACE_DIR=/path/to/your/workspace

# 访问口令（登录页校验用），必填。建议随机生成 32 字节 urlsafe 串，生成命令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=<填入生成的随机口令>

# ── 可选：模型选项 ──

# 前端可选模型列表，逗号分隔；不配则用内置默认
# CLAUDE_MODEL_OPTIONS=model-a,model-b

# ── ASR 语音识别（FunASR HTTP 网关，Whisper 风格接口，部署见 FunASR 部署文档）──

# 网关完整地址，必填才能用语音功能；换地址只改这里重启即可
ASR_API_URL=http://<FunASR服务器IP>:10095/v1/audio/transcriptions

# 热词表文件：相对路径按 backend/ 目录解析；每行「词 [权重]」（权重 1~100，缺省 20），
# # 注释与空行忽略；按 mtime 检测变更，改文件后下一次请求即生效、无需重启。
# 文件格式与示例见 backend/hotwords.example.txt
ASR_HOTWORDS_FILE=hotwords.txt
